        print("Nombre:", p["nombre"])
        print("Edad:", p["edad"])
        print("Teléfono:", p["telefono"])
        print("Dirección:", p["direccion"])
        print("Ingreso:", p["ingreso"])
        print("Salida:", p["salida"])
    else:
        print("Paciente no encontrado")

